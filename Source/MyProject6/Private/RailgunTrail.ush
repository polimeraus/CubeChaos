// UV is the radial coordinate inside the circular cross-section, including the end caps.
float2 p = UV * 2. - 1.;
float2 v = float2(dot(View, AxisY), dot(View, AxisZ));
float vv = dot(v, v);
float projected = abs(p.x * v.y - p.y * v.x) * rsqrt(max(vv, 1.e-8));
float radius = lerp(length(p), projected, smoothstep(.00001, .0009, vv));
float r2 = radius * radius;
float edge = 1. - smoothstep(.77, 1., radius);
float sheath = .57 * exp(-4.8 * r2) + .09 * exp(-1.6 * r2);
float filament = exp(-22. * r2);
float3 center = lerp(Tint, float3(.94, .99, 1.), saturate(WhiteCore));
float3 light = (Tint * sheath + center * filament * .72) * lerp(.46, 1., saturate(WhiteCore));
return float4(light * (.68 * Brightness * Density) * edge * smoothstep(0., 1., EndFade) * pow(saturate(Fade), .85), 1.);
