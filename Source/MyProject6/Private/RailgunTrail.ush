// Narrow straight rail core; the shot is frozen in world space.
float across = abs(UV.y * 2.0 - 1.0);
float core = exp(-across * across * 110.0);
float halo = exp(-across * across * 9.0) * 0.32;
float edge = 1.0 - smoothstep(0.75, 1.0, across);
float ends = smoothstep(0.0, 1.0, UV.x * BeamLength)
    * smoothstep(0.0, 1.0, (1.0 - UV.x) * BeamLength);
float profile = (core + halo) * edge * ends * saturate(Fade);
float3 color = lerp(Tint, float3(0.7, 0.9, 1.0), core * 0.32);
return float4(color * Brightness * profile * Density, 1.0);
