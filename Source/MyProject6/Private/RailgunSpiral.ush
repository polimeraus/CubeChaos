// The tube encodes signed projected distance to its centre in UV.y.
float2 p = UV * 2. - 1.;
float3 light;
if (VertexMode > .75)
{
    float d = abs(p.y);
    float body = (.42 + .34 * exp(-4.8 * d*d)) * (1. - smoothstep(.54, 1., d));
    light = .205 * (Tint * body + float3(.32, .8, 1.) * .012 * exp(-12. * d*d));
}
else
{
    float d2 = dot(p, p);
    float spot = exp(-3.8 * d2) * (1. - smoothstep(.62, 1., d2));
    if (VertexMode > .25)
        light = (Tint + .2) * spot + Tint * .24 * exp(-12. * min(abs(p.x), abs(p.y)) - 3. * sqrt(d2));
    else
        light = Tint * (.56 * spot + .12 * exp(-1.8 * d2) * (1. - smoothstep(.4, 1., d2)));
}
return light * Brightness * Density * saturate(VertexAlpha);
