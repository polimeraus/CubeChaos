// R selects a compact flash, a pressure ribbon, or the electronic fuse.
float2 p = UV * 2. - 1.;
float3 neon = lerp(float3(.015, 2.7, 4.5), float3(4., .035, 2.2), Particle.g);
float alpha = 0.;
float3 color = neon;
if (Particle.r < .15)
{
    float r = length(p);
    alpha = exp(-r*r*7.)*(1.-smoothstep(.55,1.,r));
    color = lerp(neon*.55, float3(8.,11.,13.), exp(-r*r*26.));
}
else if (Particle.r < .5)
{
    float ribbon = pow(saturate(1.-abs(p.y)),5.);
    alpha = (ribbon + .2*pow(saturate(1.-abs(p.y)),1.5))*smoothstep(0.,.07,UV.x)*(1.-smoothstep(.93,1.,UV.x));
    color = neon + float3(.7,1.,1.2)*ribbon;
}
else
{
    alpha = pow(saturate(1.-length(p)),2.);
    color = float3(.5,6.,10.);
}
return float4(color, saturate(alpha)*Particle.a);
