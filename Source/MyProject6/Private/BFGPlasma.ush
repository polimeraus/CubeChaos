// Original procedural fusion plasma inspired by the Quake Live BFG visual language.
// Advected noise replaces the old Gaussian disc and concentric ring.
struct PlasmaNoise
{
    float hash(float2 p)
    {
        // Arithmetic hash avoids twenty transcendental sine evaluations per pixel.
        float3 v=frac(float3(p.x,p.y,p.x)*.1031);
        v+=dot(v,v.yzx+33.33);
        return frac((v.x+v.y)*v.z);
    }
    float noise(float2 p)
    {
        float2 i=floor(p),f=frac(p); f=f*f*(3.-2.*f);
        return lerp(lerp(hash(i),hash(i+float2(1,0)),f.x),lerp(hash(i+float2(0,1)),hash(i+1),f.x),f.y);
    }
    float fbm(float2 p)
    {
        return noise(p)*.57+noise(p*2.13+5.7)*.28+noise(p*4.31-3.1)*.15;
    }
};
PlasmaNoise n;
float2 p=UV*2.-1.;
float r=length(p);
float t=Age;
float2 flow=float2(t*1.7,-t*2.3);
float2 warp=float2(n.noise(p*3.+flow),n.noise(p*3.-flow+11.))-.5;
float turbulence=n.fbm(p*4.3+warp*1.8+flow);
float3 green=float3(.075,1.,.045), hot=float3(.82,1.,.38);
float3 energy=0;
if(VertexMode>.75)
{
    float edge=r+(turbulence-.5)*.27;
    float cloud=pow(saturate(1.-edge),1.4)*(.25+turbulence*1.6);
    float filaments=pow(saturate(1.-abs(turbulence-.54)*9.),3.);
    energy=green*cloud*2.2+hot*filaments*cloud*.7;
    energy*=1.-smoothstep(.82,1.,r);
}
else if(VertexMode>.3)
{
    float width=lerp(.06,.65,saturate(UV.x));
    float taper=smoothstep(0.,.75,UV.x)*(1.-smoothstep(.78,1.,UV.x));
    float wake=exp(-pow((p.y+warp.y*.3)/width,2.)*2.)*taper;
    energy=green*wake*(.3+turbulence)*1.6;
}
else if(VertexMode>.1)
{
    float veins=pow(saturate(1.-abs(turbulence-.53)*8.),3.);
    energy=green*(.25+turbulence)*1.7+hot*veins*.8;
}
else
{
    float edge=r+(turbulence-.5)*.22;
    float body=pow(saturate(1.-edge*1.7),1.2);
    float veins=pow(saturate(1.-abs(turbulence-.52)*10.),3.);
    float corona=exp(-r*r*4.5)*(1.-smoothstep(.65,1.,r));
    energy=green*(body*(.5+turbulence)*2.+corona*.8)+hot*body*veins*1.4;
}
return energy*7.5*saturate(VertexAlpha);
