// Shared actor-local surface mask; no vertex displacement.

float2 size = max(Footprint.xy, 1.0);
float2 delta = (UV - 0.5) * size;
float2 radial = (UV - Footprint.zw) * size;
float radius = max(length(max(Footprint.zw, 1.0 - Footprint.zw) * size), 1.0);
float2 span = max(float2(dot(abs(Flow.xy), size), dot(abs(Flow.yx), size)), 1.0);
float travel = 0.5 + dot(delta, Flow.xy) / span.x;
float across = 0.5 + dot(delta, float2(-Flow.y, Flow.x)) / span.y;
float angle = atan2(radial.y, radial.x) / 6.28318530718;
if (Flow.z > 0.5)
{
    travel = length(radial) / radius;
    across = frac(angle - atan2(Flow.y, Flow.x) / 6.28318530718);
}
travel = saturate(Flow.w > 0.5 ? 1.0 - travel : travel);
across = saturate(across);
float4 waves[8] = { Waves0, Waves1, Waves2, Waves3, Waves4, Waves5, Waves6, Waves7 };
float glow = 0.0;
[loop] for (int i = 0; i < min((int)Fixed.y, 32); ++i)
{
    float alpha = waves[i / 4][i % 4];
    float band = max(Fixed.z, 0.001);
    float head = alpha * (1.0 + band);
    float phase = (head - travel) / band;
    float value = 0.0;
    if (Fixed.x < 1.5)
    {
        value = saturate(1.0 - abs(phase * 2.0 - 1.0));
    }
    else if (Fixed.x < 2.5)
    {
        // Several soft bands move together across the chosen coordinate field.
        value = pow(saturate(0.5 + 0.5 * cos((travel - alpha) * 6.28318530718 * Fixed.w)), 6.0);
        value *= saturate(alpha * 12.0) * saturate((1.0 - alpha) * 12.0);
    }
    else
    {
        float distance = length(radial) / radius;
        distance = Flow.w > 0.5 ? 1.0 - distance : distance;
        float stripe = frac((angle - Spiral.w - distance * Spiral.x - alpha * SpiralDirection) * Spiral.z);
        float width = clamp(Spiral.y, 0.003, 0.97);
        float edge = min(fwidth(stripe), width * 0.25);
        value = 1.0 - smoothstep(width - edge, width + edge, stripe);
    }
    glow = max(glow, value);
}
float music = 0.0;
float transparency = PlatformBacklight > 0.5 ? saturate(EqualizerTransparency) : 0.0;
if (MusicEnabled > 0.5)
{
    float2 musicUV = float2(across, travel);
    float segments = 1.0;
    float softSegments = 1.0;
    if (Equalizer.w > 0.5)
    {
        // A fixed edge anchors filled bars, independently of the fixed animation's flow.
        musicUV = Equalizer.z < 1.5 ? UV.yx : UV.xy;
        if (Equalizer.z == 1.0 || Equalizer.z == 3.0) { musicUV.y = 1.0 - musicUV.y; }
        float2 block = frac(saturate(musicUV) * Equalizer.xy);
        segments = step(0.035, block.x) * step(block.x, 0.965) * step(0.07, block.y) * step(block.y, 0.93);
        if (transparency > 0.0)
        {
            // Physical squares even when the footprint and equalizer grid have different aspect ratios.
            float2 cellSize = (Equalizer.z < 1.5 ? size.yx : size.xy) / max(Equalizer.xy, 1.0);
            float halfWidth = min(cellSize.x, cellSize.y) * 0.44;
            float2 local = abs(block - 0.5) * cellSize;
            float edge = max(local.x, local.y);
            float feather = max(halfWidth * 0.16, fwidth(edge));
            softSegments = 1.0 - smoothstep(halfWidth - feather, halfWidth, edge);
        }
    }
    float sample = Texture2DSample(MusicMask, MusicMaskSampler, musicUV).r;
    music = sample * segments;
    if (transparency > 0.0 && Equalizer.w > 0.5)
    {
        // Compress HDR peaks instead of letting 42x (or higher) emission wash the pattern white.
        float peak = max(MusicColor.r, max(MusicColor.g, MusicColor.b));
        float backlightMask = (1.0 - exp(-max(peak, 0.0) * sample / 8.0)) * softSegments;
        float3 tint = MusicColor.rgb / max(peak, 0.0001);
        // The rendered opaque surface supplies the light's color AND detail. Add only a thin
        // milky veil; do not replace/dim the original material or blur its underlying pattern.
        float3 veil = lerp(float3(0.11, 0.11, 0.11), tint * 0.11, 0.12);
        float3 backlight = (max(UnderlayScene.rgb, 0.0) * 1.15 + veil) * backlightMask;
        // Ease the legacy HDR emission down quickly enough for the middle of the slider
        // to expose the material. Both contributions vanish at full transparency.
        float legacyWeight = pow(1.0 - transparency, 4.0);
        float backlightWeight = 4.0 * transparency * (1.0 - transparency);
        return WaveColor.rgb * glow + MusicColor.rgb * music * legacyWeight + backlight * backlightWeight;
    }
}
return WaveColor.rgb * glow + MusicColor.rgb * music;
