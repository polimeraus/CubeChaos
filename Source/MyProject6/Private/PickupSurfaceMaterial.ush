// Analytic icons in face-local UVs. No texture/font dependency; enum order is EPickupMotif.
struct PickupSymbols
{
    float Segment(float2 p, float2 a, float2 b)
    {
        float2 ab = b - a;
        return length(p - a - ab * saturate(dot(p - a, ab) / max(dot(ab, ab), .000001)));
    }
    float Box(float2 p, float2 size)
    {
        float2 q = abs(p) - size;
        return length(max(q, 0)) + min(max(q.x, q.y), 0);
    }
    float Polygon(float2 p, float2 points[12], int count)
    {
        float d = 100;
        float signValue = 1;
        for (int i = 0, j = count - 1; i < count; j = i, ++i)
        {
            float2 a = points[i];
            float2 b = points[j];
            d = min(d, Segment(p, a, b));
            if ((a.y > p.y) != (b.y > p.y))
            {
                float x = a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y);
                if (p.x < x) signValue = -signValue;
            }
        }
        return d * signValue;
    }
    float Ellipse(float2 p, float2 radii)
    {
        // First-order distance, with a safe centre; keeps narrow cutouts antialiased.
        float k0 = length(p / radii);
        float k1 = length(p / (radii * radii));
        return k1 > .00001 ? k0 * (k0 - 1) / k1 : -min(radii.x, radii.y);
    }
    float FallingBomb(float2 p)
    {
        float shell = Ellipse(p - float2(0, -.22), float2(.29, .55));
        float stem = Box(p - float2(0, .35), float2(.055, .24));
        float2 fins[12];
        fins[0] = float2(-.29, .80);
        fins[1] = float2(0, .64);
        fins[2] = float2(.29, .80);
        fins[3] = float2(.29, .48);
        fins[4] = float2(0, .27);
        fins[5] = float2(-.29, .48);
        return min(shell, min(stem, Polygon(p, fins, 6)));
    }
};
PickupSymbols symbols;
float2 p = float2(UV.x - .5, .5 - UV.y) * 2 / max(IconScale, .1);
float angle = IconRotation * .01745329252;
float c = cos(angle), s = sin(angle);
p = float2(c * p.x + s * p.y, -s * p.x + c * p.y);
float distance = 1;
if (Motif < .5)
{
    float2 points[12];
    for (int i = 0; i < 10; ++i)
    {
        float a = 1.57079632679 + i * .62831853072;
        float radius = (i % 2 == 0) ? .84 : .37;
        points[i] = float2(cos(a), sin(a)) * radius;
    }
    distance = symbols.Polygon(p, points, 10);
}
else if (Motif < 1.5)
{
    float curve = 10;
    float2 last = float2(cos(2.7925268), sin(2.7925268)) * .36 + float2(0, .30);
    for (int i = 1; i <= 24; ++i)
    {
        float a = lerp(2.7925268, -1.0471976, i / 24.0);
        float2 next = float2(cos(a), sin(a)) * .36 + float2(0, .30);
        curve = min(curve, symbols.Segment(p, last, next));
        last = next;
    }
    curve = min(curve, symbols.Segment(p, last, float2(0, -.22)));
    curve = min(curve, symbols.Segment(p, float2(0, -.22), float2(0, -.30)));
    distance = min(curve - .10, length(p - float2(0, -.61)) - .115);
}
else if (Motif < 2.5)
{
    distance = max(length(p) - .79, .69 - length(p - float2(.32, .13)));
}
else if (Motif < 3.5)
{
    distance = min(symbols.Box(p, float2(.135, .77)), symbols.Box(p - float2(0, .22), float2(.61, .135)));
}
else if (Motif < 4.5)
{
    // Pointed fuselage, tail fins, exhaust flame and a circular window.
    float2 points[12];
    points[0] = float2(0, .85);
    points[1] = float2(.22, .43);
    points[2] = float2(.22, -.17);
    points[3] = float2(.48, -.48);
    points[4] = float2(.48, -.63);
    points[5] = float2(.20, -.48);
    points[6] = float2(-.20, -.48);
    points[7] = float2(-.48, -.63);
    points[8] = float2(-.48, -.48);
    points[9] = float2(-.22, -.17);
    points[10] = float2(-.22, .43);
    distance = symbols.Polygon(p, points, 11);
    distance = max(distance, .105 - length(p - float2(0, .25)));
    float2 flame[12];
    flame[0] = float2(-.12, -.56);
    flame[1] = float2(.12, -.56);
    flame[2] = float2(0, -.86);
    distance = min(distance, symbols.Polygon(p, flame, 3));
}
else if (Motif < 5.5)
{
    // Old-fashioned cartoon bomb: round shell, angled neck, curved fuse and spark.
    // The small cutout glint keeps the solid silhouette readable at pickup scale.
    float2 centre = float2(-.16, -.19);
    float shell = length(p - centre) - .58;
    float glint = 10;
    float2 last = centre + float2(cos(1.8325957), sin(1.8325957)) * .435;
    for (int i = 1; i <= 10; ++i)
    {
        float a = lerp(1.8325957, 2.9670597, i / 10.0);
        float2 next = centre + float2(cos(a), sin(a)) * .435;
        glint = min(glint, symbols.Segment(p, last, next));
        last = next;
    }
    shell = max(shell, .037 - glint);
    float2 neck = p - float2(.12, .31);
    float collar = symbols.Box(float2(dot(neck, float2(.8660254, -.5)),
                                      dot(neck, float2(.5, .8660254))), float2(.13, .135));
    distance = min(shell, collar);

    // Cubic curve sampled into a smooth, constant-width fuse.
    float2 a = float2(.18, .42);
    float2 b = float2(.20, .84);
    float2 c = float2(.47, .82);
    float2 d = float2(.47, .60);
    last = a;
    float fuse = 10;
    for (int i = 1; i <= 16; ++i)
    {
        float t = i / 16.0;
        float u = 1 - t;
        float2 next = u*u*u*a + 3*u*u*t*b + 3*u*t*t*c + t*t*t*d;
        fuse = min(fuse, symbols.Segment(p, last, next));
        last = next;
    }
    distance = min(distance, fuse - .038);
    float2 points[12];
    for (int i = 0; i < 12; ++i)
    {
        float a = .15 + i * .5235987756;
        float radius = (i % 2 == 0) ? .17 : .065;
        points[i] = float2(.58, .59) + float2(cos(a), sin(a)) * radius;
    }
    distance = min(distance, symbols.Polygon(p, points, 12));
}
else if (Motif < 6.5)
{
    // Long-tail aerial bomb, leaning nose-down to the right.
    float2 q = float2(dot(p, float2(.70710678, .70710678)),
                      dot(p, float2(-.70710678, .70710678)));
    float shell = max(symbols.Ellipse(q - float2(0, -.32), float2(.275, .50)), q.y - .02);
    float2 shoulder[12];
    shoulder[0] = float2(-.247, .02);
    shoulder[1] = float2(0, .30);
    shoulder[2] = float2(.247, .02);
    shell = min(shell, symbols.Polygon(q, shoulder, 3));
    shell = max(shell, .024 - abs(q.y + .59));
    shell = max(shell, .023 - abs(q.y - .02));
    float tail = symbols.Box(q - float2(0, .54), float2(.043, .29));
    float2 fin[12];
    fin[0] = float2(.085, .79);
    fin[1] = float2(.28, .87);
    fin[2] = float2(.28, .58);
    fin[3] = float2(.085, .44);
    distance = min(shell, min(tail, symbols.Polygon(float2(abs(q.x), q.y), fin, 4)));
}
else if (Motif < 7.5)
{
    // Retro rocket: curved fuselage, segmented nose and tail, swept fins and glint.
    float shell = symbols.Ellipse(p - float2(0, .04), float2(.31, .84));
    shell = max(shell, (abs(p.x) + .43 * p.y - .365) / 1.0885);
    shell = max(shell, .027 - abs(p.y - .52));
    shell = max(shell, .027 - abs(p.y + .29));
    shell = max(shell, -symbols.Box(p - float2(0, -.66), float2(.027, .18)));
    float glint = 10;
    float2 last = float2(-.20, .19);
    for (int i = 1; i <= 12; ++i)
    {
        float t = i / 12.0;
        float2 next = float2(-.20 - .025 * sin(t * 3.14159265), .19 - .34 * t);
        glint = min(glint, symbols.Segment(p, last, next));
        last = next;
    }
    shell = max(shell, .025 - glint);
    float2 fin[12];
    fin[0] = float2(.265, -.45);
    fin[1] = float2(.40, -.57);
    fin[2] = float2(.40, -.80);
    fin[3] = float2(.16, -.67);
    distance = min(shell, symbols.Polygon(float2(abs(p.x), p.y), fin, 4));
}
else if (Motif < 8.5)
{
    // A falling bomb with a negative-space radiation badge. One tint controls the whole icon.
    float2 q = float2(dot(p, float2(.8660254, .5)), dot(p, float2(-.5, .8660254)));
    distance = symbols.FallingBomb(q);
    float2 badge = q - float2(0, -.17);
    float radius = length(badge);
    distance = max(distance, .215 - radius);
    float trefoil = radius - .035;
    for (int i = 0; i < 3; ++i)
    {
        float a = 1.57079633 + i * 2.09439510;
        float2 axis = float2(cos(a), sin(a));
        float wedge = .8660254 * radius - dot(badge, axis);
        trefoil = min(trefoil, max(max(radius - .172, .077 - radius), wedge));
    }
    distance = min(distance, trefoil);
}
else if (Motif < 9.5)
{
    // Three clearly separated falling silhouettes, staggered like the reference formation.
    distance = symbols.FallingBomb((p - float2(-.47, .26)) / .53) * .53;
    distance = min(distance, symbols.FallingBomb((p - float2(.45, .16)) / .56) * .56);
    distance = min(distance, symbols.FallingBomb((p - float2(0, -.28)) / .72) * .72);
}
else
{
    // A broad signal puck, antenna and three expanding arcs.
    distance = symbols.Box(p-float2(0,-.4),float2(.48,.14));
    distance = min(distance,symbols.Segment(p,float2(0,-.26),float2(0,.15))-.04);
    distance = min(distance,length(p-float2(0,.16))-.09);
    for (int i=0;i<3;++i)
    {
        float2 q=p-float2(0,.12);
        float arc=abs(length(q)-(.25+i*.19))-.028;
        arc=max(arc,.12-q.y);
        distance=min(distance,arc);
    }
}
float aa = max(length(fwidth(p)) * .65, .001);
float mask = 1 - smoothstep(-aa, aa, distance);
float wave = .5 + .5 * cos(6.28318530718 * (Clock / max(PulsePeriod, .05) + PulsePhase));
wave = wave * wave * (3 - 2 * wave);
float glow = lerp(MinimumGlow, MaximumGlow, PulseEnabled > .5 ? wave : 1);
return float2(mask, mask * glow);
